<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="kr.parksy.axis">

    <!-- INTERNET 이 없으면 소켓을 아예 못 연다 (errno=1 EPERM).
         lib/main.dart 의 제어 소켓(:8492 — next/jump/reload)이 이 권한 없이는
         bind 단계에서 죽는다. 2026-09-22 로그로 확인:
           [Overlay] ctl socket fail: SocketException: Failed to create server
           socket (OS Error: Operation not permitted, errno = 1), port = 8492
         즉 그 소켓은 **한 번도 동작한 적이 없었다.** try/catch 에 삼켜져
         조용히 실패하고 있었을 뿐이다. 서버는 loopback 전용이라 외부 노출은 없다. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="Parksy Axis"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
        </activity>

        <!-- 백그라운드 무장 입구 — 에이전트가 am broadcast 로 오버레이를 세운다.
             화면을 띄우지 않고 규격·콘티를 밀어넣기 위한 유일한 문.
             서비스(OverlayService)는 exported="false" 라 밖에서 못 열지만,
             이 리시버는 같은 앱 안이라 그 서비스를 정당하게 열 수 있다.
             호출은 반드시 컴포넌트(-n)를 지정한다 — Android 14 는 암시적 브로드캐스트를 막는다. -->
        <receiver
            android:name="flutter.overlay.window.flutter_overlay_window.AxisArmReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="kr.parksy.axis.ARM"/>
                <action android:name="kr.parksy.axis.OFF"/>
                <action android:name="kr.parksy.axis.TV"/>
                <action android:name="kr.parksy.axis.TV_OFF"/>
            </intent-filter>
        </receiver>

        <service
            android:name="flutter.overlay.window.flutter_overlay_window.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="overlay_window"/>
            <meta-data
                android:name="io.flutter.embedding.android.OverlayEntryPoint"
                android:value="overlayMain"/>
        </service>

        <!-- 반대편(오른쪽 아래) 나레이터 액자 — 콘티와 별개 창.
             Flutter 가 아니라 네이티브 VideoView 다. 이유는 TvOverlayService 주석 참고:
             플러그인(flutter_overlay_window)은 창을 하나만 만들 수 있어서,
             두 번째 창은 플러그인 밖에서 직접 띄워야 한다.
             foregroundServiceType="specialUse" 인 이유는 OverlayService 와 같다 —
             녹화 내내 살아 있어야 하는데, 일반 백그라운드 서비스는 안드로이드가 죽인다. -->
        <service
            android:name="kr.parksy.axis.TvOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="overlay_window"/>
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
